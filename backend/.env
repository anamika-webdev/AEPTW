# Backend Environment Configuration (.env)

# ==================== SERVER CONFIGURATION ====================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ==================== DATABASE CONFIGURATION ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Anam@14
DB_NAME=amazon_eptw_db

# ==================== JWT CONFIGURATION ====================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# ==================== SESSION CONFIGURATION ====================
# Generate a strong secret: openssl rand -base64 64
SESSION_SECRET=your_super_secret_session_key_change_this_in_production

# ==================== FRONTEND URL ====================
FRONTEND_URL=http://localhost:3000

# ==================== GOOGLE OAuth CONFIGURATION ====================
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Default role for new Google OAuth sign-ups
DEFAULT_GOOGLE_ROLE=Requester

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== LOGGING ====================
LOG_LEVEL=info
LOG_DIR=logs

# ==================== FILE UPLOADS ====================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================== EMAIL CONFIGURATION (NODEMAILER) ====================
# This system uses Nodemailer for sending emails.
# You can use any SMTP provider (Gmail, Outlook, SendGrid, etc.)
# It does NOT use AWS SES by default.

EMAIL_ENABLED=true

# Generic SMTP Settings (Replace with your provider's details)
# For Gmail: smtp.gmail.com, Port 587, Secure false
# For Outlook: smtp-mail.outlook.com, Port 587, Secure false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Authentication Credentials
EMAIL_USER=eptw365@gmail.com
EMAIL_PASSWORD=hajmqyrydcbrrbjn

# Sender Information
EMAIL_FROM_NAME=Amazon EPTW System
EMAIL_FROM_ADDRESS=eptw365@gmail.com

# Security Options
# Set to 'false' if using self-signed certs (not recommended for production)
EMAIL_REJECT_UNAUTHORIZED=true